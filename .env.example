# Google Maps Embed API key. This value is inlined into the client bundle, so it
# MUST be restricted in Google Cloud Console:
#   - Application restriction: HTTP referrers -> https://tabernasaloia.com/*
#   - API restriction: "Maps Embed API" only
# If left empty, the Contact page shows a "Ver no Google Maps" link instead of the embed.
VITE_GOOGLE_MAPS_API_KEY=""

